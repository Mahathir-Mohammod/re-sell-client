NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# Same MongoDB cluster as re-sell-server; better-auth owns user/session/account/jwks.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# openssl rand -hex 32  (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# console.cloud.google.com -> Credentials -> OAuth client (Web app)
# redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phase 3 only
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
